# Salin file ini menjadi server/.env lalu isi. File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# Panduan: docs/11-ASISTEN-AI.md

# API key dari https://aistudio.google.com/ (Get API key). Jangan ditempel di kode, chat, atau repo.
GEMINI_API_KEY=

# Nama model. Jalankan "npm run models" untuk melihat model yang tersedia bagi key kamu.
# Pilih model Flash; GEMINI_MODEL_FALLBACK (opsional) dicoba bila model utama kehabisan kuota.
GEMINI_MODEL=
GEMINI_MODEL_FALLBACK=

# Batas permintaan AI per hari untuk seluruh server (kosong/0 = tanpa batas).
# Sesuaikan dengan kuota gratis yang terlihat di AI Studio, agar siswa mendapat pesan ramah lebih dulu.
AI_DAILY_LIMIT=

# Opsional: batas token "thinking" (mis. 0 untuk mematikan bila model mendukung). Kosongkan = bawaan model.
GEMINI_THINKING_BUDGET=

# Alamat server. 127.0.0.1 = hanya laptop ini. 0.0.0.0 = bisa dibuka HP di Wi-Fi yang sama.
PORT=3000
HOST=127.0.0.1

# Batas permintaan per perangkat per 10 menit (bawaan 20). Satu kelas di Wi-Fi sekolah sering berbagi satu IP,
# jadi di hosting naikkan sesuai jumlah siswa (mis. 60), tetapi tetap jaga AI_DAILY_LIMIT.
AI_PER_10MIN=

# ---- Mode hosting (backend terpisah dari GitHub Pages, docs/11 §9). Kosongkan untuk mode lokal. ----
# Situs yang boleh memakai API (CORS), dipisah koma. Bila diisi: situs lain ditolak & AI_DAILY_LIMIT wajib
# (bila kosong dipakai 100/hari).
ALLOWED_ORIGINS=
# Jumlah proxy di depan server agar IP tiap siswa terbaca benar (Render: 1). Kosong = tidak ada proxy.
TRUST_PROXY=
# false = hanya melayani /api (aplikasi tetap di GitHub Pages). Bawaan: true di laptop, false di hosting.
SERVE_APP=
# PENGAMAN: di hosting (terdeteksi otomatis lewat VERCEL/RENDER, atau HOSTED=true) tanpa ALLOWED_ORIGINS,
# API menutup diri: /api/status = {"ready":false,"reason":"config"} dan Gemini tidak dipanggil.
# HOSTED=true hanya perlu untuk hosting lain yang tidak terdeteksi otomatis.
HOSTED=

# Hanya untuk uji tampilan error (kosongkan saat dipakai siswa):
# quota | busy | upstream | badkey | blocked | server | nokey
AI_SIMULATE=
